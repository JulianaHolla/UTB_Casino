@model Player
@{
    ViewData["Title"] = Model.Username;
    var transactions = (IList<Transaction>)ViewBag.Transactions;
}
<h1>@Model.Username</h1>
@if (TempData["Error"] is string error) { <p class="notice error">@error</p> }
<p>Balance <strong>@Model.Balance.ToString("N2")</strong> credits. Account is @(Model.IsBlocked ? "blocked" : "active").</p>

<div class="row">
    <form asp-action="ToggleBlock" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn">@(Model.IsBlocked ? "Unblock player" : "Block player")</button>
    </form>
</div>

<h2>Adjust balance</h2>
<form asp-action="Adjust" asp-route-id="@Model.Id" method="post" class="stack">
    <div class="form-group"><label for="amount">Amount (negative removes credits)</label>
        <input id="amount" name="amount" type="number" step="0.01" class="form-control" /></div>
    <div class="form-group"><label for="note">Reason</label>
        <input id="note" name="note" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Apply adjustment</button>
</form>

<h2>Recent transactions</h2>
<table class="data">
    <thead><tr><th>Date</th><th>Type</th><th>Note</th><th class="num">Amount</th></tr></thead>
    <tbody>
    @foreach (var t in transactions)
    {
        <tr><td>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@t.Type</td><td>@t.Note</td>
            <td class="num @(t.Amount < 0 ? "neg" : "pos")">@t.Amount.ToString("+0.00;-0.00")</td></tr>
    }
    </tbody>
</table>
<p><a asp-action="Select">Back to players</a></p>
