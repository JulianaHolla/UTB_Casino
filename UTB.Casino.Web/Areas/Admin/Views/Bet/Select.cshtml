@model IList<Bet>
@{ ViewData["Title"] = "Bets"; }
<h1>Bets</h1>
<div class="table-responsive"><table class="table align-middle">
    <thead><tr><th>Date</th><th>Player</th><th>Game</th><th>Result</th><th class="text-end">Bet</th><th class="text-end">Returned</th><th></th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr><td>@b.PlacedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@b.User?.UserName</td><td>@b.Game?.Name</td><td>@b.Result</td>
            <td class="text-end">@b.Amount.ToString("N2")</td><td class="text-end">@b.Payout.ToString("N2")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-light" asp-action="Edit" asp-route-id="@b.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this bet?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>
    }
    </tbody>
</table></div>
