@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<h1>Something went wrong</h1>
<p>The request could not be completed. Go back to the <a asp-area="" asp-controller="Home" asp-action="Index">lobby</a> and try again.</p>
@if (Model.ShowRequestId) { <p>Request ID: <code>@Model.RequestId</code></p> }
