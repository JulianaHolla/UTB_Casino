@model BlackjackViewModel
@{ ViewData["Title"] = Model.Game.Name; var state = Model.State; }
<h1>@Model.Game.Name</h1>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert @(Model.IsError ? "alert-danger" : "alert-secondary")">@Model.Message</div> }

@if (state != null)
{
    <section class="felt">
        <h2 class="h5">Dealer @(state.DealerValue.HasValue ? $"({state.DealerValue})" : "")</h2>
        <div class="hand">@foreach (var card in state.DealerCards) { <partial name="_Card" model="card" /> }</div>
        <h2 class="h5 mt-3">You (@state.PlayerValue)</h2>
        <div class="hand">@foreach (var card in state.PlayerCards) { <partial name="_Card" model="card" /> }</div>
    </section>
}

@if (Model.InProgress)
{
    <div class="d-flex gap-2">
        <form asp-action="Hit" method="post"><button type="submit" class="btn btn-brass">Hit</button></form>
        <form asp-action="Stand" method="post"><button type="submit" class="btn btn-outline-light">Stand</button></form>
    </div>
}
else
{
    <form asp-action="Deal" method="post" class="bet-form">
        <div class="mb-3">
            <label for="Amount" class="form-label">Bet (@Model.Game.MinBet.ToString("N0") to @Model.Game.MaxBet.ToString("N0"))</label>
            <input id="Amount" name="Amount" type="number" step="0.01" class="form-control" value="@Model.Amount" />
        </div>
        <button type="submit" class="btn btn-brass">Deal</button>
    </form>
}
