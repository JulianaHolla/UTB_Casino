@model BlackjackViewModel
@{ ViewData["Title"] = Model.Game.Name; var round = Model.Round; }
<h1>@Model.Game.Name</h1>
@if (!string.IsNullOrEmpty(Model.Message)) { <p class="notice @(Model.IsError ? "error" : "info")">@Model.Message</p> }

@if (round != null)
{
    <section class="felt">
        <h2>Dealer @(round.IsFinished ? $"({BlackjackEngine.HandValue(round.DealerHand)})" : "")</h2>
        <div class="hand">
            @for (var i = 0; i < round.DealerHand.Count; i++)
            {
                if (i == 1 && !round.IsFinished) { <span class="card back" aria-label="Hidden card"></span> }
                else { <partial name="_Card" model="round.DealerHand[i]" /> }
            }
        </div>
        <h2>You (@BlackjackEngine.HandValue(round.PlayerHand))</h2>
        <div class="hand">
            @foreach (var card in round.PlayerHand) { <partial name="_Card" model="card" /> }
        </div>
    </section>
}

@if (Model.InProgress)
{
    <div class="row">
        <form asp-action="Hit" method="post"><button type="submit" class="btn btn-primary">Hit</button></form>
        <form asp-action="Stand" method="post"><button type="submit" class="btn">Stand</button></form>
    </div>
}
else
{
    <form asp-action="Deal" method="post" class="stack">
        <div class="form-group">
            <label for="Amount">Bet (@Model.Game.MinBet.ToString("N0") to @Model.Game.MaxBet.ToString("N0"))</label>
            <input id="Amount" name="Amount" type="number" step="0.01" class="form-control" value="@Model.Amount" />
        </div>
        <button type="submit" class="btn btn-primary">Deal</button>
    </form>
}
