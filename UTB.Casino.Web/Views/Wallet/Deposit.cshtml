@model BetViewModel
@{ ViewData["Title"] = "Add credits"; }
<h1>Add credits</h1>
<div asp-validation-summary="All" class="notice error"></div>
<form asp-action="Deposit" method="post" class="stack">
    <div class="form-group">
        <label for="Amount">Credits (1 to 1,000)</label>
        <input id="Amount" name="Amount" type="number" step="0.01" class="form-control" value="@Model.Amount" />
    </div>
    <button type="submit" class="btn btn-primary">Add credits</button>
    <a asp-action="Index" class="btn">Cancel</a>
</form>
