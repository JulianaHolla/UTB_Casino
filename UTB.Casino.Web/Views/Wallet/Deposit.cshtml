@model DepositViewModel
@{ ViewData["Title"] = "Add credits"; }
<h1>Add credits</h1>
<form asp-action="Deposit" method="post" class="bet-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3"><label asp-for="Amount" class="form-label">Credits (1 to 1,000)</label>
        <input asp-for="Amount" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span></div>
    <button type="submit" class="btn btn-brass">Add credits</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
